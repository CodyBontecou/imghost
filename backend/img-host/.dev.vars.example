# Example environment variables for local development
# Copy this to .dev.vars and fill in your values

# Required: Secret key for signing JWT tokens
# Generate with: openssl rand -base64 32
JWT_SECRET=your-secret-key-here-generate-with-openssl

# Legacy support (optional)
UPLOAD_TOKEN=legacy-test-token

# SES configuration (required for delivery; missing credentials fail without secret logs)
# Use a verified sender/recipient in a disposable test environment. Never commit credentials.
EMAIL_FROM=noreply@your-verified-domain.com
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-test-access-key
AWS_SECRET_ACCESS_KEY=your-test-secret-key

# Reset emails contain native copyable codes, not BASE_URL links.
# See SETUP_AUTH.md for SES sandbox and Apple private-relay requirements.
